# ============================================================
# XSPEERIA - LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# ============================================================
#
# TEMPLATE ONLY - NEVER PUT REAL PRODUCTION SECRETS HERE.
#
# Local development may copy this file to .env.
# Staging/Production secrets must come from the approved
# managed secrets infrastructure.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

APP_NAME=Xspeeria
APP_ENV=development
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------
# DATABASE - LOCAL DEVELOPMENT ONLY
# ------------------------------------------------------------

DATABASE_URL=postgresql+asyncpg://xspeeria_dev:CHANGE_ME@localhost:5432/xspeeria_dev

# ------------------------------------------------------------
# REDIS - LOCAL DEVELOPMENT ONLY
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# CELERY / BACKGROUND JOBS
# ------------------------------------------------------------

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------
# AUTHENTICATION / JWT
# Generate real development secrets locally.
# Never commit actual values.
# ------------------------------------------------------------

# Sign-in (ADR-025): at least 32 characters, or the app refuses to start. Without a key,
# the sign-in routes answer 503. Placeholders containing CHANGE_ME are refused in production.
JWT_SECRET_KEY=CHANGE_ME_LOCAL_ONLY_use_at_least_32_chars
JWT_ALGORITHM=HS256
# Old authenticator secrets at rest (ADR-026). Unused since ADR-054 (face check); may be empty.
MFA_ENCRYPTION_KEY=
# ADR-054: print email codes and "was this you?" alerts in the server window. APP_ENV=local only.
# Without an email sender (Resend needs a domain first), sign-up and code checks answer 503.
DEV_EMAIL=false
# ADR-054: pass every face check without a camera (no cost). APP_ENV=local only.
FACE_CHECK_DEV=false
# Payout account numbers at rest (ADR-035): base64 of 32 random bytes, generated the same way.
# Left empty, payout accounts cannot be added. A KMS-managed key replaces this before go-live.
BENEFICIARY_ENCRYPTION_KEY=
# ADR-035: pretend bank name check that approves every account. APP_ENV=local only.
BANK_CHECK_DEV=false
# ADR-039: Didit identity checks. All three or none; secrets — never commit real values.
# Workflow must include ID verification, liveness, face match and AML screening.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# ADR-054: the face check — a Didit workflow of type BIOMETRIC_AUTHENTICATION (about $0.10 each).
# Uses DIDIT_API_KEY. Left empty, face checks are off (only FACE_CHECK_DEV works, locally).
DIDIT_AUTH_WORKFLOW_ID=
# Optional: where Didit sends the user afterwards (https or xspeeria://).
DIDIT_CALLBACK_URL=
# ADR-041: required with Didit. Base64 of 32 random bytes; keys the ID-document hash that keeps
# one person to one verified account. Set once per environment (changing it breaks matching).
# python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
KYC_IDENTITY_KEY=
# ADR-042: header with the client's country set by a trusted proxy (e.g. CF-IPCountry behind
# Cloudflare). Only suggests a new country's identity check; grants nothing. Leave empty unless
# every request reaches the server through that proxy.
CLIENT_COUNTRY_HEADER=
# ADR-037: pretend partner bank for the escrow steps (in memory, moves no money). APP_ENV=local
# only. Seed its partners once: (cd backend && uv run python -m app.cli.pretend_bank)
PRETEND_BANK=false
# ADR-037: seconds between escrow background passes (funding windows, partner commands).
ESCROW_TICK_SECONDS=5
# Not read: access tokens last 15 minutes by contract (ADR-025 §2).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# ADR-052: phone push through Expo (FCM on Android, APNs on iOS). false = in-app only.
PUSH_ENABLED=false
# Optional: Expo access token if "enhanced push security" is turned on in Expo. Keep secret.
EXPO_ACCESS_TOKEN=

# ------------------------------------------------------------
# WEBHOOK SECURITY
#
# Do NOT place real banking/provider webhook secrets in this
# template. Provider-specific variables should be added only
# after the provider contract is approved.
# ------------------------------------------------------------

WEBHOOK_SHARED_SECRET=CHANGE_ME_LOCAL_ONLY

# ------------------------------------------------------------
# CORS
# Keep explicit. Never use * with credentialed production APIs.
# ------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------

LOG_LEVEL=INFO

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------

ENABLE_DOCS=true
ENABLE_REDOC=true

# ------------------------------------------------------------
# IMPORTANT
# ------------------------------------------------------------
#
# DO NOT ADD:
#
# - Production database passwords
# - Production JWT signing keys
# - Bank credentials
# - Payment-provider credentials
# - KYC-provider credentials
# - AWS credentials
# - Encryption master keys
# - Real webhook secrets
# - Customer information
#
# Provider-specific variables must only be introduced when the
# corresponding integration has been approved and documented.
#
# Production secrets belong in the approved secrets manager.
# ============================================================
