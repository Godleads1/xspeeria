# ============================================================
# XSPEERIA - LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE
# ============================================================
#
# TEMPLATE ONLY - NEVER PUT REAL PRODUCTION SECRETS HERE.
#
# Local development may copy this file to .env.
# Staging/Production secrets must come from the approved
# managed secrets infrastructure.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

APP_NAME=Xspeeria
APP_ENV=development
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------
# DATABASE - LOCAL DEVELOPMENT ONLY
# ------------------------------------------------------------

DATABASE_URL=postgresql+asyncpg://xspeeria_dev:CHANGE_ME@localhost:5432/xspeeria_dev

# ------------------------------------------------------------
# REDIS - LOCAL DEVELOPMENT ONLY
# ------------------------------------------------------------

REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------
# CELERY / BACKGROUND JOBS
# ------------------------------------------------------------

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------
# AUTHENTICATION / JWT
# Generate real development secrets locally.
# Never commit actual values.
# ------------------------------------------------------------

JWT_SECRET_KEY=CHANGE_ME_LOCAL_ONLY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# ------------------------------------------------------------
# WEBHOOK SECURITY
#
# Do NOT place real banking/provider webhook secrets in this
# template. Provider-specific variables should be added only
# after the provider contract is approved.
# ------------------------------------------------------------

WEBHOOK_SHARED_SECRET=CHANGE_ME_LOCAL_ONLY

# ------------------------------------------------------------
# CORS
# Keep explicit. Never use * with credentialed production APIs.
# ------------------------------------------------------------

CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------

LOG_LEVEL=INFO

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------

ENABLE_DOCS=true
ENABLE_REDOC=true

# ------------------------------------------------------------
# IMPORTANT
# ------------------------------------------------------------
#
# DO NOT ADD:
#
# - Production database passwords
# - Production JWT signing keys
# - Bank credentials
# - Payment-provider credentials
# - KYC-provider credentials
# - AWS credentials
# - Encryption master keys
# - Real webhook secrets
# - Customer information
#
# Provider-specific variables must only be introduced when the
# corresponding integration has been approved and documented.
#
# Production secrets belong in the approved secrets manager.
# ============================================================
