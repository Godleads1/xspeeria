{
  "expo": {
    "name": "Xspeeria",
    "slug": "xspeeria",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "xspeeria",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
