{
  "expo": {
    "name": "Xspeeria",
    "slug": "xspeeria",
    "owner": "xspeeria-01",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "xspeeria",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.xspeeria.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "../assets/brand/xspeeria-logo.png",
          "imageWidth": 290,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FD"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Xspeeria uses your photos only when you choose a profile picture, banner or ID document.",
          "cameraPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9cc8df68-2c8e-40af-9055-872188b8eeff"
      }
    }
  }
}
